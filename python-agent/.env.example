# ==============================================================================
# Core infrastructure
# ==============================================================================
INGEST_ENABLED=false
CORS_ORIGINS=https://saas.soloventures.com.br,http://localhost:5173
AGENT_INTERNAL_TOKEN=<long-random-internal-token>

# ==============================================================================
# Supabase
# ==============================================================================
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_JWT_SECRET=<supabase-jwt-secret>

# Session-mode Postgres URL. If the password contains %, @, /, ?, #, or spaces,
# URL-encode it before pasting it into DATABASE_URL.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<pooler-host>:5432/postgres

# ==============================================================================
# Model providers
# ==============================================================================
OPENAI_API_KEY=<openai-api-key>

# Optional providers for future model routing. The current Sprint 6 service reads
# OPENAI_API_KEY only, but Dokploy may carry these for later provider swaps.
ANTHROPIC_API_KEY=<anthropic-api-key>
GEMINI_API_KEY=<gemini-api-key>
GROQ_API_KEY=<groq-api-key>
VERBOO_API_KEY=<verboo-api-key>
VERBOO_BASE_URL=https://code.verboo.ai/router/v1

# ==============================================================================
# Model defaults
# ==============================================================================
AGNO_SCHEMA=agno
DOORMAN_MODEL=gpt-4o-mini
WORKER_MODEL=gpt-4o
SHAPER_MODEL=gpt-4o

