# ==============================================================================
# Core infrastructure
# ==============================================================================
INGEST_ENABLED=false
CORS_ORIGINS=https://saas.soloventures.com.br,http://localhost:5173
AGENT_INTERNAL_TOKEN=<long-random-internal-token>

# ==============================================================================
# Supabase
# ==============================================================================
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_JWT_SECRET=<supabase-jwt-secret>

# Session-mode Postgres URL. If the password contains %, @, /, ?, #, or spaces,
# URL-encode it before pasting it into DATABASE_URL.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<pooler-host>:5432/postgres

# ==============================================================================
# LLM provider (OpenAI-compatible) — switch provider with env, no code change
# ==============================================================================
# LLM_BASE_URL: set to an OpenAI-compatible router to use non-OpenAI models.
#   Verboo (open-source models, e.g. deepseek-v4-flash): https://code.verboo.ai/router/v1
#   Leave UNSET to use OpenAI's default endpoint.
# LLM_API_KEY:  key for that provider. If unset, falls back to OPENAI_API_KEY.
LLM_BASE_URL=https://code.verboo.ai/router/v1
LLM_API_KEY=<verboo-or-provider-api-key>

# Used only when LLM_BASE_URL is unset (direct OpenAI).
OPENAI_API_KEY=<openai-api-key>

# Optional keys Dokploy may carry for other providers.
ANTHROPIC_API_KEY=<anthropic-api-key>
GEMINI_API_KEY=<gemini-api-key>
GROQ_API_KEY=<groq-api-key>
VERBOO_API_KEY=<verboo-api-key>
VERBOO_BASE_URL=https://code.verboo.ai/router/v1

# ==============================================================================
# Model defaults — swap models by changing these (must be valid for LLM_BASE_URL)
# ==============================================================================
AGNO_SCHEMA=agno
DOORMAN_MODEL=deepseek-v4-flash
WORKER_MODEL=deepseek-v4-flash
SHAPER_MODEL=deepseek-v4-flash
 
